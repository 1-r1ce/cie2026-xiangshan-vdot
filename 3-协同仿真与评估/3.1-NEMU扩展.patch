diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aae..ad4a7ee5 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -23,6 +23,25 @@ def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
 
+// ===== CIE-2026 自定义指令 vdot.vv : custom-0 (opcode 0x0B), funct3=000, funct7=0 =====
+// vd[0] 的低 32 bit = sum_{i=0..7} sext8(vs1[i]) * sext8(vs2[i])，其余位清零
+def_EHelper(vdot_vv) {
+  const int vd  = BITS(s->isa.instr.val, 11, 7);
+  const int vs1 = BITS(s->isa.instr.val, 19, 15);
+  const int vs2 = BITS(s->isa.instr.val, 24, 20);
+  int32_t sum = 0;
+  int i;
+  for (i = 0; i < 8; i++) {
+    int8_t a = (int8_t)vreg_b(vs1, i);
+    int8_t b = (int8_t)vreg_b(vs2, i);
+    sum += (int32_t)a * (int32_t)b;
+  }
+  for (i = 0; i < VENUM8; i++) {
+    vreg_b(vd, i) = 0;
+  }
+  vreg_i(vd, 0) = (uint32_t)sum;
+}
+
 def_EHelper(vsub) {
   ARITH(SUB, SIGNED)
 }
